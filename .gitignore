# pebbl's store USED to live here (pebbl-history/), with ~/pebbl/.pebbl
# symlinking into it. It moved into the pebbl repo itself on 2026-07-30 so the
# tool and its memory travel together and nothing depends on a machine-specific
# symlink. Its ignore rules moved with it; see ~/pebbl/.gitignore.

.DS_Store

# vault-sync run log (local operational output)
.vault-sync.log

# This repo's own pebbl store, in SHARED mode: events.jsonl is committed and
# everything below is derived from it or private to this machine. The files
# are ignored by name because git does not look inside a blanket-ignored
# directory, so a `.pebbl/` line here would keep events.jsonl out too.
.pebbl/events.local.jsonl
.pebbl/view.sqlite
.pebbl/db.sqlite
.pebbl/manual-logs.md
.pebbl/handoffs.md
.pebbl/commit-log.md
.pebbl/narrative.md
.pebbl/events-view.md
.pebbl/*.lock
.pebbl/.rebuild-needed
.pebbl/name-map.json
!.pebbl/events.jsonl
